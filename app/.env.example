# ============================================================================
# BookAppt.ai Host Application — Environment Variables
# ============================================================================
# Copy this file to `.env` and fill in your actual values.
# Both the Flask app (run.py) and bridge (run_bridge.py) read from this.

# ── Flask Application ───────────────────────────────────────────────────────
APP_SECRET_KEY=your-secret-key-change-in-production
APP_DB_PATH=bookapt_data/bookapt.db

# ── Google Calendar OAuth2 (Phase 2) ────────────────────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/calendar/callback
GOOGLE_TOKEN_PATH=bookapt_data/google_token.json

# ── Voxlayer Engine Configuration ───────────────────────────────────────────
# These are inherited from bookapt/.env.example — all required for calls to work

# Twilio credentials
VOXLAYER_TWILIO_ACCOUNT_SID=your-twilio-account-sid
VOXLAYER_TWILIO_AUTH_TOKEN=your-twilio-auth-token
VOXLAYER_TWILIO_PHONE_NUMBER=+1234567890

# Gemini API
VOXLAYER_GEMINI_API_KEY=your-gemini-api-key

# Public webhook URLs (set these to your ngrok URLs in Phase 7)
VOXLAYER_WEBHOOK_BASE_URL=https://your-webhook-tunnel.ngrok.io
VOXLAYER_OUTBOUND_TWIML_URL=https://your-webhook-tunnel.ngrok.io/voxlayer/outbound-twiml
VOXLAYER_RECORDING_STATUS_CALLBACK_URL=https://your-webhook-tunnel.ngrok.io/voxlayer/recording-status

# Bridge WebSocket URL (set this to your bridge ngrok tunnel in Phase 7)
VOXLAYER_MEDIA_STREAM_URL=wss://your-bridge-tunnel.ngrok.io/media-stream

# Data directories (relative to project root)
VOXLAYER_DATA_DIR=bookapt_data
VOXLAYER_RECORDINGS_DIR=bookapt_data/recordings
VOXLAYER_RESULTS_DIR=bookapt_data/results
VOXLAYER_CONVERSATIONS_DIR=bookapt_data/conversations
VOXLAYER_WHISPER_TRANSCRIPTS_DIR=bookapt_data/whisper_transcripts
VOXLAYER_FINAL_TRANSCRIPTS_DIR=bookapt_data/final_transcripts
