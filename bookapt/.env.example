# ============================================================
# Voxlayer / BookAppt.ai — Environment Variables Template
# ============================================================
# Copy this file to `.env` and fill in your actual values.
# NEVER commit your real .env file — it contains secrets!

# =========================
# Required secrets
# =========================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
GEMINI_API_KEY=your_gemini_api_key

# =========================
# Twilio call defaults
# =========================
VOXLAYER_CALL_FROM_NUMBER=+15557654321
VOXLAYER_RECORD_CALLS=true

# =========================
# WhatsApp notifications
# =========================
# Your personal WhatsApp number (receives call results + can reply "callback")
USER_WHATSAPP_NUMBER=+91XXXXXXXXXX
# Twilio WhatsApp sender (sandbox: +14155238886, or your approved number)
TWILIO_WHATSAPP_FROM=+14155238886

# =========================
# Public webhook / bridge wiring (fill after tunneling)
# =========================
VOXLAYER_WEBHOOK_BASE_URL=https://your-public-webhook-host
VOXLAYER_OUTBOUND_TWIML_URL=https://your-public-webhook-host/voxlayer/voice/outbound
VOXLAYER_RECORDING_STATUS_CALLBACK_URL=https://your-public-webhook-host/voxlayer/voice/recording
VOXLAYER_MEDIA_STREAM_URL=wss://your-public-bridge-host/media-stream
VOXLAYER_HOST=0.0.0.0
VOXLAYER_PORT=5000
VOXLAYER_BRIDGE_HOST=0.0.0.0
VOXLAYER_BRIDGE_PORT=8765
VOXLAYER_BRIDGE_PATH=/media-stream

# =========================
# Gemini models
# =========================
VOXLAYER_GEMINI_LIVE_MODEL=gemini-2.0-flash-live-preview
VOXLAYER_GEMINI_VOICE_NAME=Kore
VOXLAYER_NORMALIZER_MODEL=gemini-2.5-flash
VOXLAYER_EXTRACTOR_MODEL=gemini-2.5-flash
# Fallback model used if primary 503s after all retries (Layer 3)
VOXLAYER_NORMALIZER_FALLBACK_MODEL=gemini-2.0-flash
VOXLAYER_EXTRACTOR_FALLBACK_MODEL=gemini-2.0-flash
# Optional dedicated key for normalizer/extractor if you want to split quota:
VOXLAYER_NORMALIZER_GEMINI_API_KEY=

# =========================
# Whisper
# =========================
VOXLAYER_WHISPER_MODEL=small
VOXLAYER_WHISPER_DEVICE=cpu
VOXLAYER_WHISPER_COMPUTE_TYPE=int8
VOXLAYER_WHISPER_LANGUAGE=en
VOXLAYER_WHISPER_FALLBACK_TO_CPU=true

# =========================
# Storage (all relative to VOXLAYER_DATA_DIR unless absolute)
# =========================
VOXLAYER_DATA_DIR=voxlayer_data
VOXLAYER_RECORDINGS_DIR=recordings
VOXLAYER_WHISPER_TRANSCRIPT_DIR=whisper_transcript
VOXLAYER_CONVERSATION_DIR=conversation
VOXLAYER_FINAL_TRANSCRIPT_DIR=final_transcript
VOXLAYER_NORMALIZED_TRANSCRIPT_DIR=normalized_transcript
VOXLAYER_RESULTS_DIR=results
VOXLAYER_NEGOTIATION_STATE_DIR=negotiation_state

# =========================
# Automation toggles
# =========================
VOXLAYER_AUTO_TRANSCRIBE=true
VOXLAYER_AUTO_BUILD_FINAL_TRANSCRIPT=true
VOXLAYER_AUTO_NORMALIZE=true
VOXLAYER_AUTO_EXTRACT=true
VOXLAYER_AUTO_UPDATE_RESULTS=true

# =========================
# Standalone bridge testing only (not used in production wiring)
# =========================
VOXLAYER_TEST_BOOKING_FILE=
